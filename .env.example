# Environment variables for C Learning Platform

# ============================================================================
# COMPILATION API - Choose one option
# ============================================================================

# Option 1: JDoodle API (200 requests/day, easy setup)
# Register at: https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_client_id_here
JDOODLE_CLIENT_SECRET=your_client_secret_here

# Option 2: Self-hosted Judge0 (unlimited requests)
# See QUICK_START_JUDGE0.md for setup
JUDGE0_URL=http://localhost:2358

# ============================================================================
# SELF-HOSTED JUDGE0 CREDENTIALS (if using docker-compose.judge0.yml)
# ============================================================================
# SECURITY: Generate strong random passwords for production!
# Example: openssl rand -base64 32

# PostgreSQL password for Judge0
JUDGE0_POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis password for Judge0
JUDGE0_REDIS_PASSWORD=your_secure_redis_password_here

# ============================================================================
# AI ASSISTANT (optional)
# ============================================================================
# Requires local Ollama installation
# See SETUP_OLLAMA.md for instructions
OLLAMA_URL=http://localhost:11434

# ============================================================================
# PRODUCTION DEPLOYMENT
# ============================================================================
# For Railway/Render deployment, add these variables in their dashboard
# DO NOT commit real credentials to git!
